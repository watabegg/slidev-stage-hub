{
  "name": "@slidev-stage-hub/stage-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@slidev-stage-hub/protocol": "workspace:*",
    "@slidev-stage-hub/slidev-adapter": "workspace:*",
    "@slidev/cli": "53.0.0",
    "@slidev/client": "53.0.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.15.0"
  }
}
