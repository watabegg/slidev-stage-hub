{
  "name": "@slidock/slidev-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./clicks": {
      "types": "./dist/clicks.d.ts",
      "import": "./dist/clicks.js"
    },
    "./inspect-deck": {
      "types": "./dist/inspect-deck.d.ts",
      "import": "./dist/inspect-deck.js"
    },
    "./native-manifest": {
      "types": "./dist/native-manifest.d.ts",
      "import": "./dist/native-manifest.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./static-runtime": {
      "types": "./dist/static-runtime.d.ts",
      "import": "./dist/static-runtime.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@slidock/protocol": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.15.0"
  }
}
