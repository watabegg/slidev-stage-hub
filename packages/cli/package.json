{
  "name": "@slidock/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "slidock": "dist/bin/slidock.js",
    "slive": "dist/bin/slive.js",
    "hub": "dist/bin/hub.js",
    "stage": "dist/bin/stage.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@slidock/slidock": "workspace:*",
    "@slidock/protocol": "workspace:*",
    "@slidock/slive-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
