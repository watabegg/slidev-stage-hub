{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "rootDir": "src/node",
    "outDir": "dist/node",
    "types": ["node"]
  },
  "include": ["src/node/**/*"]
}
