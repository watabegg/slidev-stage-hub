{
  "name": "@slidev-stage-hub/hub",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.client.json",
    "build": "pnpm --filter @slidev-stage-hub/protocol build && pnpm --filter @slidev-stage-hub/slidev-adapter build && pnpm build:node && pnpm build:client && node scripts/build.mjs",
    "serve": "node scripts/serve.mjs artifacts/module-graph-offline/site 4174",
    "test": "node --test scripts/fingerprint-offline.test.mjs scripts/native-player.test.mjs tests/catalog.test.mjs tests/runtime-environment.test.mjs tests/service.test.mjs tests/client.test.mjs",
    "verify:library": "node scripts/verify-library.mjs artifacts/module-graph-offline/site",
    "thumbnails": "node scripts/thumbnails.mjs artifacts/module-graph-offline/site",
    "build:node": "tsc -p tsconfig.node.json",
    "build:client": "tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@slidev-stage-hub/protocol": "workspace:*",
    "@slidev-stage-hub/slidev-adapter": "workspace:*",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "playwright-chromium": "1.63.0",
    "vue": "3.5.43"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./serve": {
      "types": "./dist/node/internal/serve.d.mts",
      "import": "./dist/node/internal/serve.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./frontend": "./src/frontend/index.ts",
    "./frontend/style.css": "./src/frontend/style.css"
  },
  "version": "0.1.0",
  "files": [
    "dist",
    "src/frontend"
  ],
  "engines": {
    "node": ">=24.15.0"
  }
}
