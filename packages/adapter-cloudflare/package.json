{
  "name": "@slidock/adapter-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./thumbnail": {
      "types": "./dist/thumbnail.d.ts",
      "import": "./dist/thumbnail.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@slidock/server": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
