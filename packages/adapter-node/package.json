{
  "name": "@slidev-stage-hub/adapter-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./artifact-store": {
      "types": "./dist/artifact-store.d.ts",
      "import": "./dist/artifact-store.js"
    },
    "./publication-store": {
      "types": "./dist/publication-store.d.ts",
      "import": "./dist/publication-store.js"
    },
    "./static-assets": {
      "types": "./dist/static-assets.d.ts",
      "import": "./dist/static-assets.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@slidev-stage-hub/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
