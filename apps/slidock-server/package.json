{
  "name": "@slidock/server-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/start.js",
    "test": "node --test tests/*.test.mjs",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@slidock/server": "workspace:*",
    "@slidock/adapter-node": "workspace:*",
    "@slidock/storage-s3": "workspace:*",
    "@slidock/storage-gcs": "workspace:*",
    "@slidock/state-postgres": "workspace:*",
    "pg": "8.23.1",
    "@slidock/renderer-playwright": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  }
}
