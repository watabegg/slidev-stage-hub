{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slidev-workers-poc",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./artifacts/site",
    "binding": "STATIC",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "slidev-workers-poc" }],
  "durable_objects": {
    // DeckVersions keeps migration v1; publication jobs add an internal SQLite schema marker.
    "bindings": [{ "name": "VERSIONS", "class_name": "DeckVersions" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeckVersions"] }],
  "vars": {
    "HUB_JOBS_ENABLED": "true",
    "LOCAL_MUTATIONS": "false",
    "PROFILE_DIGEST": "configure-from-built-runtime-and-compiler-before-remote-use",
  },
  "observability": { "enabled": true, "traces": { "enabled": true } },
}
