{
  "name": "@slidev-stage-hub/workers",
  "private": true,
  "type": "module",
  "dependencies": {
    "@slidev-stage-hub/hub": "workspace:*",
    "@slidev-stage-hub/protocol": "workspace:*",
    "@slidev-stage-hub/slidev-adapter": "workspace:*",
    "@slidev-stage-hub/server": "workspace:*",
    "@slidev-stage-hub/adapter-cloudflare": "workspace:*"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "playwright-chromium": "1.63.0",
    "vue": "3.5.43",
    "wrangler": "4.149.0",
    "@slidev-stage-hub/stage-tools": "workspace:*"
  },
  "scripts": {
    "typecheck": "pnpm run types && vue-tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "node --test tests/*.test.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "dev": "node scripts/serve.mjs",
    "verify:api": "node scripts/verify.mjs --api-only",
    "verify": "node scripts/verify.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "thumbnail": "node scripts/local-thumbnail.mjs",
    "types": "wrangler types worker-configuration.d.ts --include-runtime false && wrangler types node_modules/worker-runtime.d.ts --include-env false",
    "verify:fixtures": "node scripts/fixture-browser.mjs",
    "verify:stage": "node scripts/verify-stage.mjs"
  }
}
