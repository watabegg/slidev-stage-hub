{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "tabWidth": 2,
  "sortImports": false,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/artifacts/**",
    "**/dist/**",
    "**/target/**",
    "**/generated/**",
    "**/results/**",
    "**/*.md",
    "pnpm-lock.yaml",
    "**/*.toml",
    "**/Cargo.lock",
    "apps/slidock-worker/worker-configuration.d.ts"
  ]
}
